# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# LocalLink WebRTC & Signaling Configuration
# ==========================================

# Public STUN Server URLs (comma-separated). Default is Google public STUN pool (no TURN required for LAN / standard NAT).
VITE_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302"

# (Optional) Client-side TURN Server override
VITE_TURN_SERVER_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# (Optional) Custom Signaling Endpoint.
# Defaults automatically to the current deployment's "/api/signal" endpoint on Vercel / Cloud Run / Localhost.
VITE_SIGNALING_URL=""

# ==========================================
# Secure Server-Side TURN Configuration (Backend Only)
# Credentials here are never bundled into client-side code.
# The server will provide secure ICE servers to connected peers on demand.
# ==========================================
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
TURN_SECRET=""

